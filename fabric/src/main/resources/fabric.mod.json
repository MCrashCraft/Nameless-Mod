{
  "schemaVersion": 1,
  "id": "namelessforge",
  "version": "${version}",
  "name": "NamelessMC",
  "description": "Unofficial server-only NamelessMC integration for Fabric-compatible loaders.",
  "authors": ["MCrashCraft", "NamelessMC contributors"],
  "license": "GPL-3.0",
  "environment": "server",
  "entrypoints": { "server": ["dev.mcrashcraft.namelessforge.NamelessFabricMod"] },
  "depends": {
    "fabricloader": ">=${fabricLoader}",
    "minecraft": "${minecraftVersion}",
    "java": ">=${javaVersion}",
    "fabric-api": "*"
  },
  "suggests": { "luckperms": "*" }
}
